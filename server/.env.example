PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/shopping_mall_demo

# (optional) mongodb+srv SRV 조회가 실패할 때 — 쉼표로 여러 개
# DNS_SERVERS=8.8.8.8,1.1.1.1
NODE_ENV=development
JWT_SECRET=dev_secret_change_me
CLIENT_ORIGIN=http://localhost:5173

# PortOne REST API v2 — 결제 검증(getPayment)에 필요
# 포트원 콘솔 > 결제연동 > V2 API Secret
PORTONE_V2_API_SECRET=

# (optional) 레거시 이름으로도 읽습니다.
# PORTONE_API_SECRET=
# USD 표시 합계 → KRW 결제 금액 환산 (정수 원)
USD_TO_KRW=1350

